{
  "name": "Stink Bugs vs. Vacuums",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      },
      "$properties": {
        "DevCameraOcclusionMode": "Zoom",
        "CameraMaxZoomDistance": 24,
        "CameraMinZoomDistance": 0.5
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "Gravity": 196.2,
        "FallenPartsDestroyHeight": -40
      },
      "House": {
        "$className": "Model",
        "InteriorDetails": {
          "$path": "map/InteriorDetails.model.json"
        },
        "LivingRoom": {
          "$path": "map/LivingRoom.model.json"
        },
        "Kitchen": {
          "$path": "map/Kitchen.model.json"
        },
        "Bedroom": {
          "$path": "map/Bedroom.model.json"
        },
        "Playroom": {
          "$path": "map/Playroom.model.json"
        },
        "BugClubhouse": {
          "$path": "map/BugClubhouse.model.json"
        },
        "Stairwell": {
          "$path": "map/Stairwell.model.json"
        },
        "Upstairs": {
          "$path": "map/Upstairs.model.json"
        },
        "Attic": {
          "$path": "map/Attic.model.json"
        },
        "Rooftop": {
          "$path": "map/Rooftop.model.json"
        },
        "Accessories": {
          "$path": "map/Accessories.model.json"
        },
        "MeshDetails": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "ArtFinish": {
          "$path": "map/ArtFinish.model.json"
        }
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [
          0.43,
          0.42,
          0.4
        ],
        "OutdoorAmbient": [
          0.55,
          0.55,
          0.57
        ],
        "Brightness": 2.5,
        "ClockTime": 15,
        "GlobalShadows": true
      }
    },
    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "$ignoreUnknownInstances": true,
      "CharacterAssets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      },
      "DetailAssets": {
        "$path": "assets/imported",
        "$ignoreUnknownInstances": true
      }
    }
  }
}

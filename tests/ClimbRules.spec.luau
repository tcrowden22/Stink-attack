--!strict
local R = require("../src/shared/ClimbRules")
local function check(ok: boolean, message: string) if not ok then error(message) end end
check(R.canClimb(2,0,true,true), "Wall at reach boundary")
check(R.canClimb(1,.3,true,true), "Near-vertical surface")
check(not R.canClimb(2.01,0,true,true), "Cannot climb from a distance")
check(not R.canClimb(1,1,true,true), "Floors are not walls")
check(not R.canClimb(1,-1,true,true), "No upside-down ceiling climb")
check(not R.canClimb(1,0,false,true), "No climbing players or movable props")
check(not R.canClimb(1,0,true,false), "No climbing invisible decorations")
check(not R.canClimb(0/0,0,true,true), "Reject nonfinite distance")
print("PASS climb rules: wall reach, slope, anchored solid surfaces")

check(R.validAxis(0) and R.validAxis(-1),"Bounded input")
check(not R.validAxis(0/0) and not R.validAxis(math.huge),"Reject nonfinite input")
check(not R.validAxis("1") and not R.validAxis(2),"Reject wrong types and excessive input")
check(R.grip(4,4,true,false)==0,"Four-second grip limit even while idle")
check(R.grip(1,2,true,false)==0,"Grip never negative")
check(R.grip(1,2,false,false)==1,"No airborne recovery or regrab reset")
check(R.grip(1,2,false,true)==4,"Ground recovery capped")
print("PASS climb stamina and input validation")

check(R.canAutoStart(.5,1,.75),"Auto crawl into a wall after rest")
check(not R.canAutoStart(.49,1,1),"No auto crawl without grip")
check(not R.canAutoStart(4,0,1),"No auto crawl walking alongside wall")
check(not R.canAutoStart(4,1,.74),"Drop suppresses immediate reattachment")
print("PASS automatic crawl entry rules")

local R=require("../src/shared/BirdRules")
assert(R.onRoof(0,65,0))
assert(not R.onRoof(0,63.9,0),"Attic must be excluded")
assert(not R.onRoof(-60,66,0),"Clubhouse excluded")
assert(not R.onRoof(0,101,0))
assert(not R.onRoof(146,65,0))
assert(R.canTarget(true,true,true,65))
assert(not R.canTarget(false,true,true,2),"No human/dead targets")
assert(not R.canTarget(true,false,true,2),"No indoor targets")
assert(not R.canTarget(true,true,false,2),"No acquisition through cover")
assert(not R.canTarget(true,true,true,65.1))
assert(not R.canBite(true,true,1,1.09),"Warning before any capture")
assert(R.canBite(true,true,2.4,1.1))
assert(not R.canBite(false,true,1,3),"Cancel after leaving roof")
assert(not R.canBite(true,false,1,3),"No biting through fans")
assert(not R.canBite(true,true,2.41,3))
assert(R.travel(20,10)==2.5,"No teleport after server stall")
assert(R.travel(1,.1)==1)
assert(R.travel(2,-1)==0)
print("PASS rooftop bird boundaries, warning, cover and bounded swoop")
